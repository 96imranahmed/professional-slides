{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/96imranahmed/professional-slides/evals/result.schema.json",
  "title": "Professional Slides Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "createdAt", "results"],
  "properties": {
    "runId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "skippedCases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "reason"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "arm",
          "artifactPaths",
          "renderPaths",
          "scores",
          "criticalFailures",
          "evidence"
        ],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "arm": {"enum": ["self", "control", "treatment"]},
          "artifactPaths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "renderPaths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "briefFidelity",
              "narrativeLogic",
              "slideDesign",
              "chartIntegrity",
              "platformCorrectness",
              "editability",
              "sourceIntegrity",
              "qaEvidence"
            ],
            "properties": {
              "briefFidelity": {"type": "integer", "minimum": 1, "maximum": 5},
              "narrativeLogic": {"type": "integer", "minimum": 1, "maximum": 5},
              "slideDesign": {"type": "integer", "minimum": 1, "maximum": 5},
              "chartIntegrity": {"type": "integer", "minimum": 1, "maximum": 5},
              "platformCorrectness": {"type": "integer", "minimum": 1, "maximum": 5},
              "editability": {"type": "integer", "minimum": 1, "maximum": 5},
              "sourceIntegrity": {"type": "integer", "minimum": 1, "maximum": 5},
              "qaEvidence": {"type": "integer", "minimum": 1, "maximum": 5}
            }
          },
          "criticalFailures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "corrupt_artifact",
                "missing_deliverable",
                "invented_evidence",
                "misleading_chart",
                "unreadable_render",
                "wrong_platform",
                "reference_fidelity_breach"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 8,
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
