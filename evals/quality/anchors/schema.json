{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "professional-slides.quality-anchors/v1",
 "title": "Judge calibration anchors",
 "type": "object",
 "required": ["schema", "scale", "anchors"],
 "properties": {
  "schema": {"const": "professional-slides.quality-anchors/v1"},
  "$comment": {"type": "string"},
  "scale": {
   "type": "object",
   "required": ["min", "max"],
   "properties": {"min": {"type": "number"}, "max": {"type": "number"}}
  },
  "anchors": {
   "type": "array",
   "minItems": 10,
   "maxItems": 40,
   "items": {
    "type": "object",
    "required": ["id", "tier", "image", "sha256", "source", "why", "provisional", "humanScore"],
    "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
     "tier": {"enum": ["high", "middle", "low"]},
     "image": {"type": "string", "pattern": "^images/[a-z0-9-]+\\.(jpg|png)$"},
     "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
     "source": {
      "type": "object",
      "required": ["kind", "deck", "page"],
      "additionalProperties": false,
      "properties": {
       "kind": {"enum": ["example", "specimen"]},
       "deck": {"type": "string"},
       "page": {"type": "integer", "minimum": 1}
      }
     },
     "defectClass": {"type": "string"},
     "why": {"type": "string", "minLength": 10},
     "provisional": {"type": "boolean"},
     "humanScore": {"type": ["number", "null"]},
     "scoredBy": {"type": "string"},
     "scoredOn": {"type": "string", "format": "date"}
    }
   }
  }
 }
}
