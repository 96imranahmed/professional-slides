{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubricVersion", "verdict", "summary", "deckScores", "slides", "findings"],
  "properties": {
    "rubricVersion": {"type": "string", "const": "2"},
    "verdict": {"type": "string", "enum": ["accept", "reject"]},
    "summary": {"type": "string", "minLength": 1},
    "deckScores": {"$ref": "#/$defs/scores"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide", "verdict", "summary", "scores", "findings"],
        "properties": {
          "slide": {"type": "integer", "minimum": 1},
          "verdict": {"type": "string", "enum": ["accept", "reject"]},
          "summary": {"type": "string", "minLength": 1},
          "scores": {"$ref": "#/$defs/scores"},
          "findings": {
            "type": "array",
            "items": {"$ref": "#/$defs/finding"}
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compositionCompleteness",
        "messageArchetypeFit",
        "hierarchyEconomy",
        "evidenceDensity",
        "componentFidelity",
        "exhibitFinish",
        "navigationHierarchy",
        "visualConsistency",
        "polish"
      ],
      "properties": {
        "compositionCompleteness": {"type": "number", "minimum": 0, "maximum": 100},
        "messageArchetypeFit": {"type": "number", "minimum": 0, "maximum": 100},
        "hierarchyEconomy": {"type": "number", "minimum": 0, "maximum": 100},
        "evidenceDensity": {"type": "number", "minimum": 0, "maximum": 100},
        "componentFidelity": {"type": "number", "minimum": 0, "maximum": 100},
        "exhibitFinish": {"type": "number", "minimum": 0, "maximum": 100},
        "navigationHierarchy": {"type": "number", "minimum": 0, "maximum": 100},
        "visualConsistency": {"type": "number", "minimum": 0, "maximum": 100},
        "polish": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "observation", "reason", "recommendedChange"],
      "properties": {
        "severity": {"type": "string", "enum": ["blocker", "major", "minor"]},
        "code": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "recommendedChange": {"type": "string", "minLength": 1}
      }
    }
  }
}
