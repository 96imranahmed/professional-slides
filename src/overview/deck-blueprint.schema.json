{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/professional-slides/src/overview/deck-blueprint.schema.json",
  "title": "Professional Slides Deck Blueprint",
  "type": "object",
  "required": ["deck", "theme", "story", "slides"],
  "properties": {
    "$schema": {"type": "string"},
    "deck": {
      "type": "object",
      "required": ["title", "audience", "purpose", "deliveryMode", "outputFormats", "governingThought"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "deliveryMode": {"enum": ["live", "pre-read", "workshop", "analytical-pack"]},
        "outputFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["pptx", "google-slides", "pdf"]}
        },
        "governingThought": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["aspectRatio", "referenceDeck", "fontFamily", "accentColor"],
      "properties": {
        "aspectRatio": {"enum": ["16:9", "4:3", "custom"]},
        "referenceDeck": {"type": ["string", "null"]},
        "fontFamily": {"type": "string", "minLength": 1},
        "accentColor": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      },
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "required": ["chapters"],
      "properties": {
        "chapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["claim", "status"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "illustrative", "unresolved"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["label", "location"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "slide": {
      "type": "object",
      "required": ["number", "id", "chapter", "archetype", "actionTitle", "primaryClaim", "dominantExhibit", "evidence", "sources", "implication", "speakerNotes"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "chapter": {"type": "string", "minLength": 1},
        "archetype": {
          "enum": [
            "title",
            "section-divider",
            "executive-synthesis",
            "decomposition",
            "chart-led-insight",
            "comparison-options",
            "process-roadmap",
            "recommendation-action-plan",
            "appendix"
          ]
        },
        "actionTitle": {"type": "string", "minLength": 1},
        "primaryClaim": {"type": "string", "minLength": 1},
        "dominantExhibit": {"type": "string", "minLength": 1},
        "chartType": {"enum": ["bar", "column", "line", "stacked", "waterfall", "scatter", "bubble", "heatmap", "table"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "implication": {"type": "string", "minLength": 1},
        "referenceSlide": {"type": ["integer", "string", "null"]},
        "speakerNotes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
