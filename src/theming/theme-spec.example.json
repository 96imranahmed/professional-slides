{
  "$schema": "./theme-spec.schema.json",
  "name": "Neutral Executive",
  "derivedFrom": ["Slideworks sample", "Umbrex third edition"],
  "canvas": {
    "aspectRatio": "16:9",
    "widthInches": 13.333,
    "heightInches": 7.5
  },
  "grid": {
    "columns": 12,
    "marginInches": 0.67,
    "gutterInches": 0.16,
    "baseUnitPoints": 6
  },
  "typography": {
    "primaryFamily": "Arial",
    "fallbackFamilies": ["Helvetica", "sans-serif"],
    "roles": {
      "display": {"sizePoints": 32, "weight": 700, "lineSpacing": 1.05},
      "actionTitle": {"sizePoints": 24, "weight": 700, "lineSpacing": 1.08},
      "body": {"sizePoints": 15, "weight": 400, "lineSpacing": 1.18},
      "micro": {"sizePoints": 8, "weight": 400, "lineSpacing": 1.1}
    }
  },
  "colors": {
    "ink": "#051C2C",
    "mutedInk": "#5D6678",
    "paper": "#FFFFFF",
    "panel": "#F2F4F7",
    "rule": "#D7DCE5",
    "accent": "#19D3C5",
    "accentSecondary": "#629CD0",
    "positive": "#18864B",
    "caution": "#D48A12",
    "negative": "#C74343",
    "darkCanvas": "#16207B",
    "onDark": "#FFFFFF"
  },
  "charts": {
    "seriesOrder": ["#16207B", "#629CD0", "#19D3C5", "#8D98AA", "#D7DCE5"],
    "gridline": {"color": "#E4E7EC", "widthPoints": 0.5},
    "axis": {"color": "#8D98AA", "widthPoints": 0.75}
  },
  "components": {
    "title": {"xInches": 0.67, "yInches": 0.38, "widthInches": 12, "heightInches": 0.8},
    "footer": {"yInches": 7.15, "heightInches": 0.18},
    "sectionTracker": {"position": "top", "activeColor": "#19D3C5", "inactiveColor": "#D7DCE5"}
  },
  "platformFallbacks": {
    "powerpoint": {"font": "Arial", "editableCharts": true},
    "googleSlides": {"font": "Arial", "editableCharts": true, "avoidCustomGeometry": true}
  }
}
