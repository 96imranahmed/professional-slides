{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/professional-slides/theme-spec.schema.json",
  "title": "Professional Slides Theme Specification",
  "type": "object",
  "required": ["name", "canvas", "grid", "typography", "colors", "charts", "components", "platformFallbacks"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "derivedFrom": {"type": "array", "items": {"type": "string"}},
    "canvas": {
      "type": "object",
      "required": ["aspectRatio", "widthInches", "heightInches"],
      "properties": {
        "aspectRatio": {"enum": ["16:9", "4:3", "custom"]},
        "widthInches": {"type": "number", "exclusiveMinimum": 0},
        "heightInches": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "grid": {
      "type": "object",
      "required": ["columns", "marginInches", "gutterInches", "baseUnitPoints"],
      "properties": {
        "columns": {"type": "integer", "minimum": 2},
        "marginInches": {"type": "number", "minimum": 0},
        "gutterInches": {"type": "number", "minimum": 0},
        "baseUnitPoints": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": ["primaryFamily", "fallbackFamilies", "roles"],
      "properties": {
        "primaryFamily": {"type": "string", "minLength": 1},
        "fallbackFamilies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "roles": {"type": "object", "minProperties": 4}
      }
    },
    "colors": {
      "type": "object",
      "required": ["ink", "mutedInk", "paper", "panel", "rule", "accent", "darkCanvas", "onDark"],
      "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
    },
    "charts": {"type": "object", "required": ["seriesOrder", "gridline", "axis"]},
    "components": {"type": "object", "required": ["title", "footer", "sectionTracker"]},
    "platformFallbacks": {"type": "object", "required": ["powerpoint", "googleSlides"]}
  },
  "additionalProperties": false
}

